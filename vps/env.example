# Configuration Domaine & Reverse Proxy
DOMAIN=api.velaris.money

# Configuration WAHA (WhatsApp HTTP API)
WAHA_API_KEY=votre_cle_api_waha_secrete
WAHA_WEBHOOK_SECRET=votre_secret_webhook
WAHA_WEBHOOK_HMAC_KEY=votre_cle_hmac_sha256_40_caracteres
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=votre_mot_de_passe_dashboard

# Configuration Supabase (Base de données PostgreSQL & Auth)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SECRET_KEY=votre_service_role_key_supabase

# Configuration Fournisseurs IA
DEEPSEEK_API_KEY=votre_cle_deepseek_ou_kie
KIE_API_KEY=votre_cle_api_kie_ai

# Clé d'administration du moteur (SÉCURITÉ — obligatoire en production)
# Protège les endpoints sensibles : /api/test/*, /api/copilot, /api/qr/restart, /api/qr/pairing-code.
# À fournir via `Authorization: Bearer <clé>` ou `X-Admin-Key`.
# Si absente, ces endpoints sont désactivés (503).
ADMIN_API_KEY=generer_une_cle_aleatoire_longue_ici
